{
  "name": "even-g2-aviation-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supplemental heads-up situational-awareness display for Even Realities G2 smart glasses, targeted at airline cruise (A320). GPS positioning via Garmin GLO. Not a certified instrument.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "preview:mobile": "vite preview --config vite.mobile.config.ts --port 5174",
    "dev:glasses": "vite --config vite.glasses.config.ts",
    "build:glasses": "tsc --noEmit && vite build --config vite.glasses.config.ts",
    "preview:glasses": "vite preview --config vite.glasses.config.ts --port 5175",
    "dev:glasses-gfx": "vite --config vite.glasses-gfx.config.ts",
    "build:glasses-gfx": "tsc --noEmit && vite build --config vite.glasses-gfx.config.ts",
    "preview:glasses-gfx": "vite preview --config vite.glasses-gfx.config.ts --port 5178",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "briefing": "node scripts/build-briefing.mjs",
    "ofp": "tsx scripts/parse-ofp.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.23.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}
